<Window x:Class="ClipboardManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ClipboardManager.App.ViewModels"
        mc:Ignorable="d"
        Title="Clipboard Manager"
        Width="1120"
        Height="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <Border Margin="24"
            Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Color="Black" Opacity="0.15" Direction="270" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Margin="24,24,24,0"
                    Height="60"
                    Background="{StaticResource SearchBackgroundBrush}"
                    CornerRadius="16"
                    BorderBrush="{StaticResource SearchBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                               Text="&#xE71E;" 
                               FontFamily="Segoe MDL2 Assets" 
                               Foreground="{StaticResource MutedTextBrush}" 
                               VerticalAlignment="Center" 
                               Margin="18,0,0,0" 
                               FontSize="18" />
                    <TextBox x:Name="SearchTextBox"
                             Grid.Column="1"
                             Margin="8,0,18,0"
                             VerticalContentAlignment="Center"
                             FontSize="18"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource PrimaryTextBrush}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Grid>
                                                <TextBlock x:Name="Placeholder" 
                                                           Text="Search history..." 
                                                           Foreground="{StaticResource MutedTextBrush}" 
                                                           VerticalAlignment="Center" 
                                                           Visibility="Collapsed" />
                                                <ScrollViewer x:Name="PART_ContentHost" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="Text" Value="" />
                                                        <Condition Property="IsFocused" Value="False" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="Transparent">
                    <Grid>
                        <ListBox x:Name="HistoryListBox"
                                 ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedItem}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 SelectionChanged="HistoryListBox_OnSelectionChanged"
                                 MouseDoubleClick="HistoryListBox_OnMouseDoubleClick"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <EventSetter Event="MouseEnter" Handler="HistoryListBoxItem_OnMouseEnter" />
                                    <EventSetter Event="PreviewMouseLeftButtonUp" Handler="HistoryListBoxItem_OnPreviewMouseLeftButtonUp" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Root" 
                                                        Padding="12,5" 
                                                        Background="{TemplateBinding Background}" 
                                                        CornerRadius="12"
                                                        BorderThickness="1"
                                                        BorderBrush="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                                                        <Setter TargetName="Root" Property="BorderBrush" Value="#15FFFFFF" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentMutedBrush}" />
                                                        <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ClipboardItemViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <Border Grid.Column="0" 
                                                Width="32" 
                                                Height="32" 
                                                Background="{StaticResource AccentMutedBrush}" 
                                                CornerRadius="8"
                                                VerticalAlignment="Center">
                                            <TextBlock VerticalAlignment="Center" 
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="16" 
                                                       Text="{Binding TypeGlyph}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Title}" 
                                                       Foreground="{StaticResource PrimaryTextBrush}" 
                                                       FontSize="14" 
                                                       FontWeight="Medium" 
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,2,0,0" 
                                                       Text="{Binding Subtitle}" 
                                                       Foreground="{StaticResource SecondaryTextBrush}" 
                                                       FontSize="11" 
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        
                                        <TextBlock Grid.Column="2" 
                                                   VerticalAlignment="Center" 
                                                   Foreground="{StaticResource MutedTextBrush}" 
                                                   FontSize="11" 
                                                   Text="{Binding TimeLabel}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsClearCommandActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Border Padding="12,8"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="12">
                                <Grid Height="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               FontSize="18"
                                               Text="⌫" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CommandPreview}"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Top"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="16"
                                               Text="↩" />
                                </Grid>
                            </Border>

                            <Border Margin="0,8,0,0"
                                    Padding="12,8"
                                    Background="Transparent"
                                    CornerRadius="12">
                                <Grid Height="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               FontSize="18"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="i" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Clear Clipboard History"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Text="{Binding ClearCommandUsage}"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" 
                        Background="{StaticResource RightPanelBrush}" 
                        CornerRadius="24" 
                        Padding="24"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel x:Name="EmptyPreviewPanel" VerticalAlignment="Center">
                                <TextBlock Text="" 
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="48"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock x:Name="EmptyPreviewText"
                                           Margin="0,16,0,0"
                                           Text="Select an item to preview"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="16"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <ScrollViewer x:Name="TextPreviewPanel"
                                          Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="TextPreviewContent"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="15"
                                           LineHeight="24" />
                            </ScrollViewer>

                            <StackPanel x:Name="FilePreviewPanel"
                                        Visibility="Collapsed"
                                        VerticalAlignment="Center">
                                <Border Background="{StaticResource LeftPanelBrush}" 
                                        Width="120" 
                                        Height="120" 
                                        CornerRadius="24"
                                        BorderBrush="{StaticResource SearchBorderBrush}"
                                        BorderThickness="1">
                                    <Image x:Name="FilePreviewIcon" Width="64" Height="64" Stretch="Uniform" />
                                </Border>
                                <TextBlock x:Name="FilePreviewText"
                                           Margin="0,24,0,0"
                                           FontSize="18"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center" />
                            </StackPanel>

                            <Border x:Name="ImagePreviewBox"
                                    Visibility="Collapsed"
                                    CornerRadius="16"
                                    ClipToBounds="True">
                                <Viewbox StretchDirection="DownOnly" 
                                         Stretch="Uniform"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Image x:Name="ImagePreviewControl" />
                                </Viewbox>
                            </Border>
                        </Grid>
                        <Border Grid.Row="1" 
                                Margin="0,24,0,0" 
                                Padding="12,8" 
                                Background="{StaticResource LeftPanelBrush}" 
                                CornerRadius="8"
                                HorizontalAlignment="Right">
                            <TextBlock x:Name="PreviewFooterText"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       FontWeight="Medium" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="28,16,28,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="12" Text="Copy again  •  " />
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="12" Text="Delete" />
                </StackPanel>
                <TextBlock Grid.Column="1" HorizontalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" FontWeight="Medium" Text="{Binding StatusMessage}" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Text="Esc to close" />
            </Grid>
        </Grid>
    </Border>
</Window>
