<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#E61B1F27" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="SearchBackgroundBrush" Color="#CC232A35" />
    <SolidColorBrush x:Key="SearchBorderBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="LeftPanelBrush" Color="#80141A22" />
    <SolidColorBrush x:Key="RightPanelBrush" Color="#66161C25" />
    <SolidColorBrush x:Key="PreviewCardBrush" Color="#80252C39" />
    <SolidColorBrush x:Key="AccentBrush" Color="#CC72C5D3" />
    <SolidColorBrush x:Key="HoverBrush" Color="#333A4657" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF7F7F8" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CCF7F7F8" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#99F7F7F8" />

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="#222B3644" />
        <Setter Property="BorderBrush" Value="#33485A6D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="#FF2A3441" />
        <Setter Property="BorderBrush" Value="#333A4657" />
        <Setter Property="Padding" Value="14,10" />
    </Style>
</ResourceDictionary>
