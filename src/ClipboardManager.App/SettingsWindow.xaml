<Window x:Class="ClipboardManager.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="480"
        Height="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource RightPanelBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Settings" />

        <StackPanel Grid.Row="1" Margin="0,24,0,0">
            <CheckBox Content="Launch at startup" IsChecked="{Binding LaunchAtStartup}" Margin="0,0,0,16" />
            <CheckBox Content="Capture images" IsChecked="{Binding CaptureImages}" Margin="0,0,0,16" />
            <CheckBox Content="Capture files and folders" IsChecked="{Binding CaptureFiles}" Margin="0,0,0,16" />
            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Hotkey" />
            <TextBox Margin="0,8,0,16" Text="{Binding HotkeyGesture}" />
            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Retention Days" />
            <TextBox Margin="0,8,0,16" Text="{Binding RetentionDays}" />
            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Max History Items" />
            <TextBox Margin="0,8,0,0" Text="{Binding MaxItems}" />
            <Button Margin="0,20,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding ClearHistoryCommand}"
                    Content="Clear All History" />
            <TextBlock Margin="0,10,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="{Binding ClearHistoryMessage}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,16,0,0"
                       Foreground="#FFFFA8A8"
                       Text="{Binding ValidationMessage}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="96" Margin="0,0,12,0" Command="{Binding CancelCommand}" Content="Cancel" />
            <Button Width="96" Command="{Binding SaveCommand}" Content="Save" />
        </StackPanel>
    </Grid>
</Window>
