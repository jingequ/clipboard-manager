<Window x:Class="ClipboardManager.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="520"
        Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundColor}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Border Background="{StaticResource PanelBackgroundBrush}" 
            BorderBrush="{StaticResource PanelBorderBrush}" 
            BorderThickness="1" 
            Margin="0">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="{StaticResource PrimaryTextBrush}" 
                       Text="Settings" />

            <ScrollViewer Grid.Row="1" Margin="0,24,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="General" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,16" />
                    
                    <CheckBox Content="Launch at startup" IsChecked="{Binding LaunchAtStartup}" Margin="0,0,0,16" />
                    <CheckBox Content="Capture images" IsChecked="{Binding CaptureImages}" Margin="0,0,0,16" />
                    <CheckBox Content="Capture files and folders" IsChecked="{Binding CaptureFiles}" Margin="0,0,0,24" />

                    <TextBlock Text="Configuration" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,16" />
                    
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Text="Hotkey" Margin="0,0,0,8" />
                            <TextBox Text="{Binding HotkeyGesture}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Text="Retention Days" Margin="0,0,0,8" />
                            <TextBox Text="{Binding RetentionDays}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Text="Max History Items" Margin="0,0,0,8" />
                    <TextBox Text="{Binding MaxItems}" Margin="0,0,0,24" />

                    <TextBlock Text="Maintenance" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,16" />
                    
                    <Button HorizontalAlignment="Left"
                            Command="{Binding ClearHistoryCommand}"
                            Content="Clear All History"
                            Background="#22EF4444"
                            BorderBrush="#44EF4444"
                            Foreground="#FEE2E2" />
                            
                    <TextBlock Margin="0,12,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               Text="{Binding ClearHistoryMessage}"
                               TextWrapping="Wrap" />
                               
                    <TextBlock Margin="0,16,0,0"
                               Foreground="#FFFFA8A8"
                               FontSize="12"
                               Text="{Binding ValidationMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="100" Margin="0,0,12,0" Command="{Binding CancelCommand}" Content="Cancel" Background="Transparent" />
                <Button Width="100" Command="{Binding SaveCommand}" Content="Save" Background="{StaticResource AccentBrush}" Foreground="Black" FontWeight="Bold" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
